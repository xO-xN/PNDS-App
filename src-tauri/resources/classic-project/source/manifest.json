{
  "schemaVersion": 2,
  "id": "pnds-template",
  "name": "Template",
  "version": "0.7.0",
  "description": "PNDS score project template: two-fader touch performer (amp / freq) driving one sine voice per client with 16-channel output.",
  "scoreServer": {
    "entry": "server.js",
    "workingDirectory": ".",
    "performerPort": 6868,
    "monitorPort": 6869,
    "supportsPerformerUrl": true
  },
  "audio": {
    "defaultMode": "internal",
    "supportedModes": [
      "internal",
      "external",
      "none"
    ],
    "outputChannels": 16,
    "synthdefs": [
      "supercollider/synthdefs/template-sine.scsyndef"
    ],
    "scsynth": {
      "blockSize": 64,
      "audioBusChannels": 64
    },
    "standaloneTarget": "127.0.0.1:57110"
  },
  "sharedLibraries": [
    {
      "id": "express",
      "version": "5.3.0"
    },
    {
      "id": "osc-min",
      "version": "2.1.2"
    },
    {
      "id": "qrcode",
      "version": "1.5.4"
    },
    {
      "id": "socket.io",
      "version": "4.8.4"
    },
    {
      "id": "p5",
      "version": "2.3.4"
    }
  ]
}
