{
  "schemaVersion": 1,
  "id": "multichannel-signal-generator",
  "name": "Multichannel Signal Generator",
  "version": "1.0.0",
  "description": "PNDS utility project: 16-ch sine wave test for checking Internal multichannel routing.",
  "scoreServer": {
    "entry": "server.js",
    "workingDirectory": ".",
    "performerPort": 6868,
    "monitorPort": 6869
  },
  "audio": {
    "defaultMode": "internal",
    "supportedModes": ["internal"],
    "outputChannels": 16,
    "synthdefs": ["supercollider/synthdefs/multichannel-signal-generator.scsyndef"],
    "scsynth": {
      "sampleRate": 48000,
      "blockSize": 64,
      "audioBusChannels": 128
    }
  }
}
